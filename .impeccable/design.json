  "narrative": {
    "northStar": "The Operations Ledger",
    "overview": "The site should look like operational software a logistics business would trust with money movement. Precise, calm, slightly technical, confident. Whitespace and a strict type scale do the work illustration usually does. The product UI (real HELIX operator-console screenshots) is the main visual; diagrams are second; everything else is flat text and bordered cards. Creativity lives inside the system: no one-off colours, spacing, or radii.",
    "keyCharacteristics": [
      "Light mode only (color-scheme: light); no dark theme.",
      "Flat: 1px borders and tonal surface for hierarchy; shadow only on product frames.",
      "Mono for data and labels; sans for prose.",
      "One accent, used rarely, for CTAs, links, focus and diagram highlights.",
      "Text is the LCP candidate; screenshots never block it."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Accent covers well under 10% of any viewport. One primary-style button per viewport.",
        "section": "colors"
      },
      {
        "name": "The No-Gradient Rule",
        "body": "No gradient text or backgrounds and no coloured section fills beyond --surface and --accent-tint. The only background pattern is the hatched device.",
        "section": "colors"
      },
      {
        "name": "The Token Rule",
        "body": "A raw hex, rgb, or px value in a component fails review.",
        "section": "colors"
      },
      {
        "name": "The Mono-For-Data Rule",
        "body": "AWB numbers, rates, weights, COD amounts and step indices are mono and tabular; numeric columns right-aligned.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Cards, buttons, fields and badges carry no shadow. Shadows exist only on product frames.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do render h1, subhead, trust line, primary CTA, entity line and info@ in server HTML.",
      "Do write headlines that state a fact, outcome or claim; use Capability -> Outcome for features.",
      "Do use real console screenshots with explicit width/height, AVIF/WebP, hero <= 120KB.",
      "Do limit motion to two moments per page, transform and opacity only, reduced-motion safe.",
      "Do build diagrams as inline SVG with only --ink, --border and --accent, with title/desc and a caption.",
      "Do label sample tenants as fictional."
    ],
    "donts": [
      "Don't ship dark mode, gradients, glass, glows, blobs, sparkles, shimmer, confetti, particles, or canvas/WebGL.",
      "Don't use parallax, scroll-jacking, auto-advancing carousels, or autoplay video above the fold.",
      "Don't use stock photos, AI imagery, fake dashboards, placeholder logos, avatars, or metrics.",
      "Don't hardcode hostnames, emails, or the founding year; read siteConfig.",
      "Don't hide an unconfirmed claim with CSS; omit it from the build.",
      "Don't use an animation library above the fold or add a dependency without recording measured KB."
    ]
  }
