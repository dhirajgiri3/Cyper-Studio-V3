# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (machine-local; .claude/settings.json and .claude/skills are shared)
.claude/settings.local.json
CLAUDE.local.md

# impeccable (config.json, design.json, README.md are shared; the rest is per-developer or generated)
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/sessions/
.impeccable/live/*.json
!.impeccable/live/config.json
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
.impeccable/shots/
